# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8000
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/sharekar_db?schema=public"

# --- Secrets (REQUIRED, min 32 chars each, different from each other) ---
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_PEPPER=

# --- Token lifetimes (optional) ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# --- Web / cookies ---
# Comma-separated list of exact frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173
# true in production (HTTPS only). false for local http://localhost dev.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (0 = none).
TRUST_PROXY=0

# --- OTP delivery ---
# console = print OTP in the server log (dev only; refused in production)
# smtp    = send real email via the SMTP_* settings below
OTP_DELIVERY=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShareKar <no-reply@yourdomain.com>"

# --- Profile images (Cloudinary, free tier) ---
# Dashboard > Settings > API Keys. Required in production; optional locally
# (without them the image-upload endpoint answers 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Account deletion ---
# Days a deleted account stays deactivated before personal data is wiped.
CCOUNAT_RETENTION_DAYS=30
